{
  "name": "pop-culture-bee-quiz",
  "version": "0.1.0",
  "private": true,
  "description": "Preliminary online qualifying quiz for the Trivia Nationals Pop Culture Bee",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --experimental-strip-types --watch src/server.ts",
    "start": "node --disable-warning=ExperimentalWarning --experimental-strip-types src/server.ts",
    "seed": "node --disable-warning=ExperimentalWarning --experimental-strip-types src/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test src/*.test.ts"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.3"
  }
}
