[Unit]
Description=Back up Timed Quiz SQLite database
After=timed-quiz.service

[Service]
Type=oneshot
User=timedquiz
Group=timedquiz
WorkingDirectory=/var/www/timed-quiz/current
EnvironmentFile=/etc/timed-quiz.env
Environment=QUIZ_BACKUP_DIR=/var/backups/timed-quiz
ExecStart=/usr/bin/bash scripts/backup-db.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/timed-quiz
